Hardware Components (same as before)
Arduino UNO
3 × IR Sensors
3 × LED Lights
1 × LDR Module
Breadboard & Jumper Wires
Power Supply (5V)
⚙️ Circuit Connections (Arduino UNO)
🔹 IR Sensors
IR Sensor	VCC	GND	OUT	Arduino UNO Pin
IR Sensor 1	5V	GND	OUT	D8
IR Sensor 2	5V	GND	OUT	D12
IR Sensor 3	5V	GND	OUT	D13
🔹 LEDs
LED	Anode (+)	Cathode (-)	Arduino UNO Pin
LED 1	D3	GND	D3
LED 2	D5	GND	D5
LED 3	D6	GND	D6
(You can use 220Ω resistors in series with LEDs for safety)
🔹 LDR Module
LDR Module Pin	Arduino UNO Connection
VCC	5V
GND	GND
OUT	D7
💡 Working Principle
When it’s daytime → LDR senses light → all street lights OFF.
When it’s nighttime → LDR detects darkness → system activates.
If an object (like a vehicle or person) passes near any IR sensor → that particular LED glows


Code for Arduino nano 


int IR1 = 8; int IR2 = 12; int IR3 = 13; int LDR = 7; int led1 = 3; 
int led2 = 5;

int led3 = 6;

int val1;

int val2;

int val3;

int val4;

void setup()

{

pinMode(IR1,INPUT);

pinMode(IR2,INPUT);

pinMode(IR3,INPUT);

pinMode(LDR,INPUT);

pinMode(led1,OUTPUT);

pinMode(led2,OUTPUT);

pinMode(led3,OUTPUT);

}
void loop() {

val1 = digitalRead(IR1);

val2 = digitalRead(IR2);

val3 = digitalRead(IR3);

val4 = digitalRead(LDR);

if(val1==1&&val4==0&&val2==1&&val3==1)

{

digitalWrite(3,LOW);

digitalWrite(5,LOW);

digitalWrite(6,LOW);
}

else if(val1==1&&val4==1&&val2==1&&val3==1)

{

analogWrite(3,20);

analogWrite(5,20);

analogWrite(6,20);

}
else if(val1==0&&val4==1&&val2==1&&val3==1)

{

analogWrite(3,500);

analogWrite(5,20);

analogWrite(6,20);

}

else if(val1==1&&val4==1&&val2==0&&val3==1)

{
analogWrite(3,20);
analogWrite(5,500);
analogWrite(6,20);
}
else if(val1==1&&val4==1&&val2==1&&val3==0)
{
analogWrite(3,20);
analogWrite(5,20);

analogWrite(6,500);

}

}

| Condition               | LDR Output | IR Output | LED Status |
| ----------------------- | ---------- | --------- | ---------- |
| Daytime                 | HIGH       | Any       | OFF        |
| Night + No Object       | LOW        | HIGH      | OFF        |
| Night + Object near IR1 | LOW        | IR1=LOW   | LED1 ON    |
| Night + Object near IR2 | LOW        | IR2=LOW   | LED2 ON    |
| Night + Object near IR3 | LOW        | IR3=LOW   | LED3 ON    |
